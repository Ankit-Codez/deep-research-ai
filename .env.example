# Copy to .env in the directory from which you run the CLI.
# Environment variables override .env values. Never commit real keys.
MOCK_MODE=true
# Mock mode ignores provider keys and returns fixed, labeled RAG sample data.
# Set false for real research; both your selected LLM key and Tavily key are needed.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
# Range: 0 to 1. Leave blank to use the provider's default temperature.
# Some reasoning models require the default; choose a compatible model/value.
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
# Structured evidence/verification needs room for complete JSON and reasoning.
LLM_MAX_OUTPUT_TOKENS=8192
OPENAI_API_KEY=

# Optional alternative: pip install -e ".[anthropic]"
# Set LLM_PROVIDER=anthropic and LLM_MODEL=claude-sonnet-4-6.
ANTHROPIC_API_KEY=

# Optional Gemini: pip install -e ".[gemini]"
# Set MOCK_MODE=false, LLM_PROVIDER=google_genai, and a Gemini model ID.
# Set LLM_TEMPERATURE= to use the provider default.
GOOGLE_API_KEY=
# Optional fallback if GOOGLE_API_KEY is empty:
GEMINI_API_KEY=
# Optional: low reduces reasoning overhead for compatible Gemini models.
# Leave blank to use the model default; check the selected model's supported levels.
GEMINI_THINKING_LEVEL=

# Real Tavily search uses HTTPX; mocks make no network requests.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Graph usable-page cap. Failed downloads consume attempts, not usable slots.
# --max-pages can lower, but never exceed, RESEARCH_MAX_PAGES.
# Legacy --workflow single still uses RESEARCH_MAX_PAGES as an attempt cap.
RESEARCH_MAX_PAGES=5
RESEARCH_MAX_PAGE_ATTEMPTS=15
# Extra search rounds before evidence extraction when fewer than 2 pages exist.
RESEARCH_MAX_SOURCE_RETRIES=2
RESEARCH_RESULTS_PER_QUERY=5
RESEARCH_MAX_CONTENT_CHARS=8000
RESEARCH_MAX_RESPONSE_BYTES=1000000
RESEARCH_REQUEST_TIMEOUT=10
RESEARCH_PAGE_DEADLINE=30
RESEARCH_REQUEST_DELAY=1
RESEARCH_MAX_REDIRECTS=3

# Graph-only controls. Extra research rounds share all run-wide budgets above/below.
# Separate follow-ups for unresolved high-priority claims after verification.
RESEARCH_MAX_RETRIES=2
RESEARCH_MAX_LLM_CALLS=16
RESEARCH_MAX_SEARCHES=12
RESEARCH_MAX_ELAPSED_SECONDS=180
RESEARCH_MAX_TOKENS=200000
# Transient model/search retries; every attempt consumes the budgets.
# Graph mode disables hidden SDK retries. LLM_MAX_RETRIES remains for smoke/single.
PROVIDER_MAX_RETRIES=1
PROVIDER_BACKOFF_SECONDS=0.5
# Optional estimated USD admission budget. Set all three current account rates
# before enabling it. No rates or model prices are hardcoded into the project.
# RESEARCH_MAX_COST_USD=0.10
RESEARCH_INPUT_COST_PER_MILLION=0
RESEARCH_OUTPUT_COST_PER_MILLION=0
RESEARCH_SEARCH_COST_USD=0
LOG_LEVEL=INFO

# All backend/worker terminals must use the same database URL and working directory.
# scripts/postgres_local.py init replaces this with a generated local credential.
DATABASE_URL=postgresql+psycopg://deepresearch@127.0.0.1:55432/deepresearch
# Local HTTP development only; production requires HTTPS and secure cookies.
APP_ENV=development
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=12
AUTH_ALLOW_REGISTRATION=true
AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://127.0.0.1:5173","http://localhost:5173"]
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# Per-user allowances reset at midnight UTC; reservations belong to submission day.
QUOTA_DAILY_RUNS=20
QUOTA_DAILY_TOKENS=1000000
QUOTA_MAX_ACTIVE_RUNS=3
# Optional: requires RESEARCH_MAX_COST_USD and all three positive cost rates above.
# QUOTA_DAILY_COST_USD=1.00
# Optional build served by FastAPI after: cd frontend; npm.cmd run build
FRONTEND_DIST_DIR=frontend/dist
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=60
# Failed runs resume explicitly from compatible checkpoints; unknown paid calls block replay.
RESEARCH_MAX_RESUMES=2
# SSE connections reconnect automatically; API rechecks the session while streaming.
PROGRESS_STREAM_SECONDS=25
# In-dashboard alerts use estimated/reserved exposure, not provider invoices.
ADMIN_DAILY_SPEND_ALERT_USD=10
ADMIN_QUEUE_ALERT_SECONDS=120
# Export limit applies to uncompressed contents and the completed ZIP.
ACCOUNT_EXPORT_MAX_BYTES=20000000
